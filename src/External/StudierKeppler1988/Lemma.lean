module

public import Phylogenetics.Tree.NeighborJoining
public import Mathlib.Tactic.FinCases
public import Mathlib.Algebra.BigOperators.Fin

/-!
# Studier and Keppler 1988: the Lemma fails at a polytomy

J. A. Studier, K. J. Keppler, *A note on the neighbor-joining algorithm of Saitou and Nei*, Mol. Biol. Evol. 5 (1988), 729-731,
p. 730: "Assume that `D` is generated by a tree in which all branches are positive. Saitou and Nei (1987) prove the following lemma:
*Lemma:* If `i` and `j` are neighbors, then `S_ij` is the strictly least element in its row and column. *Proof:* Each summand in
formula (5a) is positive."

Here `S_ij = (N - 2) D_ij - R_i - R_j`, with `R_i = ∑_k D_ik`, which is `Phylogenetics.NJ.State.Q`, and formula (5a) is
`S_ik - S_ij = ∑_{m ≠ i,j,k} (D_ik + D_jm - D_ij - D_km)`.

The letter asks only for positive branches, and does not ask for a binary tree. On the star with four leaves and unit weights all
`S_ij` are `-8` (`Q_star`), and any two leaves are neighbours (`nbr_star`), so no `S_ij` is strictly least (`not_lemmaAsPrinted`):
each summand of (5a) is `0` (`summand_star`). The theorem that follows the Lemma in the letter holds, polytomies included, by
another comparison: `Phylogenetics.NJ.exists_QC_lt_of_not_nbr`.
-/

@[expose] public noncomputable section

open Finset Phylogenetics Phylogenetics.NJ
open scoped Classical

namespace External.StudierKeppler1988

/-- **The Lemma of Studier and Keppler 1988, as printed**, on the library's definitions: for a tree with positive branches and
neighbours `i, j`, the entry `S_ij` is strictly below every other entry in its row and its column. Neighbours are `Nbr`, the pairs
that form a cherry of a resolution of the tree. -/
def LemmaAsPrinted : Prop :=
  ∀ (X : Type) [Fintype X] [DecidableEq X] (T : Finset (Finset X)) (w : Finset X → ℝ),
    IsUnrootedTree T → (∀ A ∈ T, 0 < w A ∧ w Aᶜ = w A) →
    ∀ i j : X, i ≠ j → Nbr T {i} {j} → ∀ k, k ≠ i → k ≠ j →
      (init (treeMetric T w)).Q {i} {j} < (init (treeMetric T w)).Q {i} {k} ∧
        (init (treeMetric T w)).Q {i} {j} < (init (treeMetric T w)).Q {k} {j}

/-- The rooting of the star on four leaves. -/
def starHierarchy : Finset (Finset (Fin 4)) := {univ, {0}, {1}, {2}, {3}}

/-- The star on four leaves, by the sides of its splits. -/
def star : Finset (Finset (Fin 4)) := unroot starHierarchy

theorem star_isUnrootedTree : IsUnrootedTree star :=
  ⟨starHierarchy, by unfold IsHierarchy starHierarchy; decide, rfl⟩

/-- Unit weights. -/
def unit (_ : Finset (Fin 4)) : ℝ := 1

/-- The metric of the star with unit weights: leaves are at distance `2`. -/
theorem treeMetric_star (a b : Fin 4) : treeMetric star unit a b = if a = b then 0 else 2 := by
  have h : ∀ a b : Fin 4, (star.filter fun A => a ∈ A ∧ b ∉ A).card = if a = b then 0 else 2 := by
    unfold star starHierarchy unroot
    decide
  unfold treeMetric unit
  rw [sum_const, nsmul_eq_mul, mul_one, h a b]
  split_ifs <;> simp

theorem card_active : (univ.image (singleton : Fin 4 → Finset (Fin 4))).card = 4 := by decide

theorem rowSum_star (a : Fin 4) : (init (treeMetric star unit)).rowSum {a} = 6 := by
  unfold State.rowSum
  simp only [init]
  rw [sum_image fun x _ y _ h => singleton_injective h]
  simp only [sum_singleton, treeMetric_star]
  fin_cases a <;> norm_num [Fin.sum_univ_four]

/-- **All the entries of `S` on the star are `-8`.** -/
theorem Q_star {a b : Fin 4} (hab : a ≠ b) : (init (treeMetric star unit)).Q {a} {b} = -8 := by
  unfold State.Q
  rw [rowSum_star, rowSum_star]
  simp only [init, card_active, sum_singleton, treeMetric_star, hab, ite_false]
  norm_num

/-- Any two leaves of the star are neighbours. -/
theorem nbr_star {a b : Fin 4} (hab : a ≠ b) : Nbr star {a} {b} := by
  have h : ∀ a b : Fin 4, a ≠ b → ∀ S ∈ star, ({a} : Finset (Fin 4)) ⊆ S → Disjoint ({b} : Finset (Fin 4)) S →
      S = {a} ∨ Sᶜ = {b} := by
    unfold star starHierarchy unroot
    decide
  exact h a b hab

/-- **Each summand of formula (5a) vanishes on the star**, where the letter's proof of the Lemma says that it is positive. -/
theorem summand_star {i j k m : Fin 4} (hij : i ≠ j) (hik : i ≠ k) (hjm : j ≠ m) (hkm : k ≠ m) :
    treeMetric star unit i k + treeMetric star unit j m - treeMetric star unit i j -
      treeMetric star unit k m = 0 := by
  simp only [treeMetric_star, hij, hik, hjm, hkm, ite_false]
  norm_num

/-- **Studier and Keppler's Lemma fails at a polytomy** (`ext:studier_keppler_lemma`): on the star with four leaves and unit weights,
two neighbours have `S_ij = S_ik`. The letter's Theorem holds on such trees (`Phylogenetics.NJ.exists_QC_lt_of_not_nbr`). -/
theorem not_lemmaAsPrinted : ¬ LemmaAsPrinted := by
  intro h
  have hlt := (h (Fin 4) star unit star_isUnrootedTree (fun _ _ => ⟨one_pos, rfl⟩) 0 1 (by decide)
    (nbr_star (by decide)) 2 (by decide) (by decide)).1
  rw [Q_star (by decide), Q_star (by decide)] at hlt
  exact lt_irrefl _ hlt

end External.StudierKeppler1988
